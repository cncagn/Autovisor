[user-account]
;配置账号密码，留空则打开网页后需手动登录
username =
password =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9222

[script-option]
;自动滑块只支持登录页，课中安全验证仍需手动完成
enableAutoCaptcha = False
enableHideWindow = False
showDonateCode = False

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 0
;每天累计播放限额/min；同日重启只使用剩余额度，0 关闭每日累计
dailyLimitMinutes = 30
;每个账号固定一个别名；换账号请改名或使用独立目录，留空则尝试自动识别
studyProfile = account1
reviewCompletedCourses = False
limitSpeed = 1.0
soundOff = True

[course-url]
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
